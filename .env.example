# ===================================================
# AmalSense - Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to git.
# ===================================================

# ---- Server ----
NODE_ENV=development          # development | production
PORT=3000                     # HTTP port (default: 3000)

# ---- Database ----
# Omit in development to use local sqlite.db by default.
# Required in production (e.g. file path or libsql:// URL).
DATABASE_URL=sqlite.db

# ---- Authentication (REQUIRED in production) ----
# Must be at least 32 random characters for security.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ---- OAuth ----
OAUTH_SERVER_URL=             # e.g. https://auth.yourserver.com
VITE_APP_ID=                  # App ID from your OAuth provider
OWNER_OPEN_ID=                # Your admin account open ID

# ---- AI / LLM ----
GROQ_API_KEY=                 # https://console.groq.com/keys
BUILT_IN_FORGE_API_URL=       # Optional: Forge API endpoint
BUILT_IN_FORGE_API_KEY=       # Optional: Forge API key

# ---- News & Data Sources ----
NEWS_API_KEY=                 # https://newsapi.org
GNEWS_API_KEY=                # https://gnews.io
YOUTUBE_API_KEY=              # https://console.cloud.google.com

# ---- Notifications ----
TELEGRAM_BOT_TOKEN=           # https://t.me/BotFather

# ---- Analytics (optional, frontend) ----
# Enable by setting these and uncommenting the script in client/index.html
VITE_ANALYTICS_ENDPOINT=      # e.g. https://analytics.yourserver.com
VITE_ANALYTICS_WEBSITE_ID=    # Website ID from your analytics provider
VITE_MIXPANEL_TOKEN=          # https://mixpanel.com
